= `codeduel_draft_${problemId}_${selectedLanguage}`;\n77:       localStorage.setItem(draftKey, value || '');\n78:       setTimeout(() => setSavedStatus('Saved'), 400);\n79:     }\n80: \n81:     if (onTyping) {\n82:       if (typingTimerRef.current) clearTimeout(typingTimerRef.current);\n83:       typingTimerRef.current = setTimeout(() => {\n84:         onTyping();\n85:       }, 400);\n86:     }\n87:   };\n88: \n89:   const handleResetCode = () => {\n90:     if (window.confirm('Reset code to initial template? Your current draft will be overwritten.')) {\n91:       const defaultCode = starterCodes && starterCodes[selectedLanguage] ? starterCodes[selectedLanguage] : '';\n92:       setCode(defaultCode);\n93:       const draftKey = `codeduel_draft_${problemId}_${selectedLanguage}`;\n94:       localStorage.removeItem(draftKey);\n95:       setSavedStatus('Reset');\n96:     }\n97:   };\n98: \n99:   const handleKeyDown = (e) => {\n100:     if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {\n101:       e.preventDefault();\n102:       if (!submitting && !running && onSubmit) {\n103:         onSubmit(selectedLanguage, code);\n104:       }\n105:     }\n106:   };\n107: \n108:   return (\n109:     <div className=\"flex flex-col h-full bg-dark-900 border border-dark-700 rounded-2xl overflow-hidden shadow-2xl\" onKeyDown={handleKeyDown}>\n110:       {/* Editor Header Bar */}\n111:       <div className=\"flex items-center justify-between px-3 sm:px-4 py-2 bg-dark-800 border-b border-dark-700 flex-shrink-0 gap-2\">\n112:         <div className=\"flex items-center space-x-2 min-w-0\">\n113:           {/* Language Selector */}\n114:           <div className=\"relative flex-shrink-0\">\n115:             <select\n116:               value={selectedLanguage}\n117:               onChange={(e) => handleLanguageChange(e.target.value)}\n118:               className=\"bg-dark-900 text-xs font-bold text-cyan-300 border border-dark-600 rounded-lg px-2.5 py-1.5 pr-7 appearance-none focus:outline-none focus:border-cyan-500 cursor-pointer shadow-sm\"\n119:             >\n120:               {Object.entries(LANGUAGE_CONFIGS).map(([key, config]) => (\n121:                 <option key={key} value={key} className=\"bg-dark-900 text-white\">\n122:                   {config.name}\n123:                 </option>\n124:               ))}\n125:             </select>\n126:             <ChevronDown className=\"w-3.5 h-3.5 text-slate-400 absolute right-2 top-2.5 pointer-events-none\" />\n127:           </div>\n128: \n129:           <span className=\"text-[11px] font-mono text-slate-400 hidden sm:inline truncate\">\n130:             {savedStatus}\n131:           </span>\n132:         </div>\n133: \n134:         {/* Action Buttons - Always Visible & Never Compressed */}\n135:         <div className=\"flex items-center space-x-2 flex-shrink-0\">\n136:           <button\n137:             type=\"button\"\n138:             onClick={handleResetCode}\n139:             title=\"Reset code\"\n140:             className=\"p-1.5 text-slate-400 hover:text-slate-200 hover:bg-dark-700 rounded-lg transition-colors flex-shrink-0\"\n141:           >\n142:             <RotateCcw className=\"w-3.5 h-3.5\" />\n143:           </button>\n144: \n145:           {onRun && (\n146:             <button\n147:               type=\"button\"\n148:               onClick={() => onRun(selectedLanguage, code)}\n149:               disabled={running || submitting}\n150:               className=\"flex items-center space-x-1.5 px-3 py-1.5 text-xs font-bold text-slate-200 bg-dark-700 hover:bg-dark-600 rounded-lg border border-dark-500 transition-all disabled:opacity-50 flex-shrink-0 whitespace-nowrap shadow-sm\"\n151:             >\n152:               <Play className=\"w-3.5 h-3.5 text-cyan-400 fill-cyan-400\" />\n153:               <span>{running ? 'Running...' : 'Run'}</span>\n154:             </button>\n155:           )}\n156: \n157:           <button\n158:             type=\"button\"\n159:             onClick={