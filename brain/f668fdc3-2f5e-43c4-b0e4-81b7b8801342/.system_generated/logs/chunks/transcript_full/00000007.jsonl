lassName=\"py-4 px-4 text-right\">\n                        <span className=\"inline-flex items-center gap-1 text-amber-400 font-bold\">\n                          <Flame className=\"w-3.5 h-3.5 fill-amber-400\" />\n                          <span>{entry.winStreak}</span>\n                        </span>\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n","Description":"Leaderboard page component","Overwrite":true,"TargetFile":"C:\\Users\\rajan\\.gemini\\antigravity\\scratch\\codeduel\\frontend\\src\\pages\\Leaderboard.jsx","toolAction":"Creating Leaderboard.jsx","toolSummary":"Write Leaderboard page"}}]}
