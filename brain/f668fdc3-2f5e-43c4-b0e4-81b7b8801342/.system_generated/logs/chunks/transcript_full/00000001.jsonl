rchByUsername(@Param(\"query\") String query, Pageable pageable);\n}\n","Description":"UserRepository interface","Overwrite":true,"TargetFile":"C:\\Users\\rajan\\.gemini\\antigravity\\scratch\\codeduel\\backend\\src\\main\\java\\com\\codeduel\\repository\\UserRepository.java","toolAction":"Creating UserRepository.java","toolSummary":"Write UserRepository"}}]}
