5:         } else if (\"Binary Search\".equals(category) && index <= classicBinarySearchTitles.length) {\n326:             return classicBinarySearchTitles[index - 1];\n327:         } else if (\"Graphs\".equals(category) && index <= classicGraphTitles.length) {\n328:             return classicGraphTitles[index - 1];\n329:         } else if (\"Dynamic Programming\".equals(category) && index <= classicDpTitles.length) {\n330:             return classicDpTitles[index - 1];\n331:         } else if (\"Trees & BST\".equals(category) && index <= classicTreeTitles.length) {\n332:             return classicTreeTitles[index - 1];\n333:         }\n334: \n335:         // Programmatic naming with meaningful DSA patterns\n336:         String prefix = switch (category) {\n337:             case \"Arrays & Hashing\" -> \"Array & Hashing: \";\n338:             case \"Two Pointers & Sliding Window\" -> \"Window & Pointers: \";\n339:             case \"Binary Search\" -> \"Binary Search: \";\n340:             case \"Strings\" -> \"String Matrix: \";\n341:             case \"Linked List\" -> \"List Manipulation: \";\n342:             case \"Stack & Monotonic Stack\" -> \"Monotonic Stack: \";\n343:             case \"Queue & Deque\" -> \"Queue Stream: \";\n344:             case \"Trees & BST\" -> \"Tree Traversal: \";\n345:             case \"Heap / Priority Queue\" -> \"Priority Heap: \";\n346:             case \"Greedy\" -> \"Optimal Greedy: \";\n347:             case \"Backtracking\" -> \"State Backtracking: \";\n348:             case \"Graphs\" -> \"Graph Network: \";\n349:             case \"Dynamic Programming\" -> \"DP Optimization: \";\n350:             case \"Bit Manipulation\" -> \"Bitwise Operation: \";\n351:             case \"Trie\" -> \"Prefix Trie: \";\n352:             default -> \"Advanced DS: \";\n353:         };\n354: \n355:         String pattern = switch ((index % 6)) {\n356:             case 0 -> \"Optimal Partition\";\n357:             case 1 -> \"Range Query\";\n358:             case 2 -> \"Subsequence Transformation\";\n359:             case 3 -> \"Maximum Cost Path\";\n360:             case 4 -> \"Frequency Target\";\n361:             default -> \"K-Factor Evaluation\";\n362:         };\n363: \n364:         return prefix + pattern + \" Variant \" + index + \" (\" + diff.name().charAt(0) + diff.name().substring(1).toLowerCase() + \")\";\n365:     }\n366: \n367:     private String generateProblemDescription(String title, String category, Difficulty diff) {\n368:         return \"Given an input dataset representing standard competitive programming constraints for **\" + title + \"**,\\n\\n\" +\n369:                 \"Your task is to implement an optimal algorithm in **O(\" + getExpectedTimeComplexity(category, diff) + \")** time and **O(\" + getExpectedSpaceComplexity(category, diff) + \")** space.\\n\\n\" +\n370:                 \"### Task Details\\n\" +\n371:                 \"- Process the input stream adhering to all specified constraints.\\n\" +\n372:                 \"- Ensure execution efficiency and memory optimization for maximum duel scoring.\\n\" +\n373:                 \"- Handle edge cases including minimum boundary elements, duplicates, and extreme scale factors.\\n\";\n374:     }\n375: \n376:     private String generateConstraints(Difficulty diff) {\n377:         return switch (diff) {\n378:             case EASY -> \"- `1 <= nums.length <= 10^4`\\n- `-10^6 <= nums[i] <= 10^6`\\n- `Time limit: 2.0s`\\n- `Memory limit: 256MB`\";\n379:             case MEDIUM -> \"- `1 <= nums.length <= 10^5`\\n- `-10^9 <= nums[i] <= 10^9`\\n- `Time limit: 2.0s`\\n- `Memory limit: 256MB`\";\n380:             case HARD -> \"- `1 <= nums.length <= 2 * 10^5`\\n- `-10^9 <= nums[i] <= 10^9`\\n- `Queries count <= 10^5`\\n- `Time limit: 3.0s`\\n- `Memory limit: 256MB`\";\n381:         };\n382:     }\n383: \n384:     private String generateExamples(String title, String category) {\n385:         return \"[\\n\" +\n386:                 \"  {\\n\" +\n387:                 \"    \\\"input\\\": \\\"nums = [2, 7, 11, 15], target = 9\\\",\\n\" +\n388:                 \"    \\\"output\\\": \\\"[0, 1]\\\",\\n\" +\n389:                 \"    \\\"explanation\\\": \\\"Because nums[0] + nums[1] == 9, we return [0, 1].\\\"\\n\" +\n390:                 \"  },\\n\" +\n391:                 \"  {\\n\" +\n392:                 \"    \\\"input\\\": \\\"nums = [3, 2, 4], target = 6\\\",\\n\" +\n393:                 \"    \\\"output\\\": \\\"[1, 2]\\\",\\n\" +\n394:                 \"    \\\"explanation\\\": \\\"Because nums[1] + nums[2] == 6, we return [1, 2].\\\"\\n\" +\n395:                 \"  }\\n\" +\n396:                 \"]\";\n397:     }\n398: \n399:     private String getExpectedTimeComplexity(String category, Difficulty diff) {\n400:         if (\"Binary Search\".equals(category)) return \"log n\";\n401:         if (\"Arrays & Hashing\".equals(category) || \"Two Pointers & Sliding Window\".equals(category) || \"Strings\".equals(category) || \"Linked List\".equals(category) || \"Bit Manipulation\".equals(category)) {\n402:             return diff == Difficulty.HARD ? \"n log n\" : \"n\";\n403:         }\n404:         if (\"Trees & BST\".equals(category) || \"Graphs\".equals(category)) {\n405:             return \"V + E\";\n406:         }\n407:         if (\"Dynamic Programming\".equals(category)) {\n408:             return diff == Difficulty.HARD ? \"n * m\" : \"n\";\n409:         }\n410:         return \"n log n\";\n411:     }\n412: \n413:     private String getExpectedSpaceComplexity(String category, Difficulty diff) {\n414:         if (\"Bit Manipulation\".equals(category) || \"Two Pointers & Sliding Window\".equals(category)) return \"1\";\n415:         if (\"Dynamic Programming\".equals(category)) return diff == Difficulty.EASY ? \"1\" : \"n\";\n416:         return \"n\";\n417:     }\n418: \n419:     private String generateStarterCodeJava(String title) {\n420:         return \"import java.util.*;\\n\\npublic class Solution {\\n    public int[] solve(int[] nums, int target) {\\n        // Write your solution here\\n        Map<Integer, Integer> map = new HashMap<>();\\n        for (int i = 0; i < nums.length; i++) {\\n            int complement = target - nums[i];\\n            if (map.containsKey(complement)) {\\n                return new int[]{map.get(complement), i};\\n            }\\n            map.put(nums[i], i);\\n        }\\n        return new int[]{};\\n    }\\n}\";\n421:     }\n422: \n423:     private String generateStarterCodePython(String title) {\n424:         return \"class Solution:\\n    def solve(self, nums: list[int], target: int) -> list[int]:\\n        # Write your solution here\\n        seen = {}\\n        for i, num in enumerate(nums):\\n            comp = target - num\\n            if comp in seen:\\n                return [seen[comp], i]\\n            seen[num] = i\\n        return []\\n\";\n425:     }\n426: \n427:     private String generateStarterCodeCpp(String title) {\n428:         return \"#include <iostream>\\n#include <vector>\\n#include <unordered_map>\\n\\nusing namespace std;\\n\\nclass Solution {\\npublic:\\n    vector<int> solve(vector<int>& nums, int target) {\\n        unordered_map<int, int> map;\\n        for (int i = 0; i < nums.size(); i++) {\\n            int complement = target - nums[i];\\n            if (map.count(complement)) {\\n                return {map[complement], i};\\n            }\\n            map[nums[i]] = i;\\n        }\\n        return {};\\n    }\\n};\";\n429:     }\n430: \n431:     private String generateStarterCodeJs(String title) {\n432:         return \"function solve(nums, target) {\\n    // Write your solution here\\n    const map = new Map();\\n    for (let i = 0; i < nums.length; i++) {\\n        const complement = target - nums[i];\\n        if (map.has(complement)) {\\n            return [map.get(complement), i];\\n        }\\n        map.set(nums[i], i);\\n    }\\n    return [];\\n}\";\n433:   