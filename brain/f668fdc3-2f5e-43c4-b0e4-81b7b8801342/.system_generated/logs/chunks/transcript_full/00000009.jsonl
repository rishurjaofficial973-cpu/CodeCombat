         </button>\n92:           <span className=\"text-dark-600\">|</span>\n93:           <span className=\"font-mono font-bold text-xs text-cyan-400\">{problem?.id}: {problem?.title}</span>\n94:         </div>\n95: \n96:         <div className=\"flex items-center space-x-2\">\n97:           {problem?.isSolvedByMe && (\n98:             <span className=\"flex items-center gap-1 text-xs font-semibold text-emerald-400\">\n99:               <CheckCircle2 className=\"w-4 h-4\" />\n100:               <span>Solved</span>\n101:             </span>\n102:           )}\n103:         </div>\n104:       </div>\n105: \n106:       {/* 2-Column Split Workspace */}\n107:       <div className=\"flex-1 p-3 grid grid-cols-1 lg:grid-cols-12 gap-3 min-h-0 overflow-hidden\">\n108:         {/* Left: Problem statement */}\n109:         <div className=\"lg:col-span-5 h-full overflow-hidden flex flex-col\">\n110:           <ProblemStatement problem={problem} />\n111:         </div>\n112: \n113:         {/* Right: Monaco Editor + Test Results */}\n114:         <div className=\"lg:col-span-7 h-full flex flex-col space-y-3 overflow-hidden\">\n115:           <div className=\"flex-1 min-h-0\">\n116:             <MonacoCodeEditor\n117:               problemId={problem?.id}\n118:               starterCodes={problem?.starterCodes}\n119:               onSubmit={handleSubmitSolution}\n120:               onRun={handleRunCode}\n121:               submitting={submitting}\n122:               running={running}\n123:             />\n124:           </div>\n125: \n126:           <div className=\"h-60 min-h-0\">\n127:             <TestResultsPanel result={latestResult} loading={running || submitting} />\n128:           </div>\n129:         </div>\n130:       </div>\n131:     </div>\n132:   );\n133: };\n134: \nThe above content shows the entire, complete file contents of the requested file.\n"}
