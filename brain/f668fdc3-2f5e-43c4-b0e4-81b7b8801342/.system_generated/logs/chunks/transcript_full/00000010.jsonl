         </div>\n206: \n207:                 <div className=\"flex items-center space-x-4 self-end sm:self-center\">\n208:                   <Link\n209:                     to={`/practice/${p.id}`}\n210:                     className=\"px-4 py-1.5 rounded-xl font-bold text-xs text-white bg-indigo-600 hover:bg-indigo-500 transition-colors\"\n211:                   >\n212:                     Solve\n213:                   </Link>\n214:                 </div>\n215:               </div>\n216:             ))}\n217:           </div>\n218:         )}\n219: \n220:         {/* Pagination Bar */}\n221:         <div className=\"p-4 bg-dark-900 border-t border-dark-700 flex items-center justify-between text-xs text-slate-400 font-mono\">\n222:           <div>\n223:             Page <span className=\"text-white font-bold\">{page + 1}</span> of <span className=\"text-white font-bold\">{totalPages}</span>\n224:           </div>\n225: \n226:           <div className=\"flex items-center space-x-2\">\n227:             <button\n228:               onClick={() => setPage(prev => Math.max(0, prev - 1))}\n229:               disabled={page === 0}\n230:               className=\"p-1.5 rounded-lg bg-dark-800 hover:bg-dark-700 disabled:opacity-30 disabled:pointer-events-none text-slate-300\"\n231:             >\n232:               <ChevronLeft className=\"w-4 h-4\" />\n233:             </button>\n234:             <button\n235:               onClick={() => setPage(prev => Math.min(totalPages - 1, prev + 1))}\n236:               disabled={page >= totalPages - 1}\n237:               className=\"p-1.5 rounded-lg bg-dark-800 hover:bg-dark-700 disabled:opacity-30 disabled:pointer-events-none text-slate-300\"\n238:             >\n239:               <ChevronRight className=\"w-4 h-4\" />\n240:             </button>\n241:           </div>\n242:         </div>\n243:       </div>\n244:     </div>\n245:   );\n246: };\n247: \nThe above content shows the entire, complete file contents of the requested file