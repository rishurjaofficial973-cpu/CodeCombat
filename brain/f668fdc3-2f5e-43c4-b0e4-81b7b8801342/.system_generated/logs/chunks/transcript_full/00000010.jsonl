ransactional(readOnly = true)\n34:     public Page<ProblemDto> getFilteredProblems(Difficulty difficulty, String topic, String search, Pageable pageable, Long currentUserId) {\n35:         Page<Problem> problems = problemRepository.findFilteredProblems(difficulty, topic, search, pageable);\n36: \n37:         Set<String> solvedProblemIds = new HashSet<>();\n38:         if (currentUserId != null) {\n39:             solvedProblemIds.addAll(userProblemHistoryRepository.findSolvedProblemIdsByUserId(currentUserId));\n40:         }\n41: \n42:         return problems.map(p -> {\n43:             ProblemDto dto = ProblemDto.fromEntity(p, false);\n44:             dto.setIsSolvedByMe(solvedProblemIds.contains(p.getId()));\n45:             return dto;\n46:         });\n47:     }\n48: \n49:     @Transactional(readOnly = true)\n50:     public ProblemDto getProblemDtoById(String id, Long currentUserId) {\n51:         Problem problem = problemRepository.findById(id)\n52:                 .orElseThrow(() -> new ResourceNotFoundException(\"Problem not found with id: \" + id));\n53: \n54:         ProblemDto dto = ProblemDto.fromEntity(problem, true);\n55:         if (currentUserId != null) {\n56:             Optional<UserProblemHistory> history = userProblemHistoryRepository.findByUserIdAndProblemId(currentUserId, id);\n57:             history.ifPresent(uph -> {\n58:                 dto.setIsSolvedByMe(uph.getIsSolved());\n59:                 dto.setMyBestRuntimeMs(uph.getBestRuntimeMs());\n60:             });\n61:         }\n62:         return dto;\n63:     }\n64: \n65:     @Transactional(readOnly = true)\n66:     public Problem selectProblemForMatch(Long player1Id, Long player2Id, Difficulty preferredDifficulty, String preferredTopic, int avgRating) {\n67:         Difficulty targetDifficulty = preferredDifficulty;\n68:         if (targetDifficulty == null) {\n69:             if (avgRating < 1200) {\n70:                 targetDifficulty = Difficulty.EASY;\n71:             } else if (avgRating <= 1650) {\n72:                 targetDifficulty = random.nextBoolean() ? Difficulty.EASY : Difficulty.MEDIUM;\n73:             } else if (avgRating <= 2000) {\n74:                 targetDifficulty = Difficulty.MEDIUM;\n75:             } else {\n76:                 targetDifficulty = random.nextBoolean() ? Difficulty.MEDIUM : Difficulty.HARD;\n77:             }\n78:         }\n79: \n80:         // Get played problem IDs for both players to avoid repetition\n81:         List<String> played1 = player1Id != null ? userProblemHistoryRepository.findPlayedProblemIdsByUserId(player1Id) : Collections.emptyList();\n82:         List<String> played2 = player2Id != null ? userProblemHistoryRepository.findPlayedProblemIdsByUserId(player2Id) : Collections.emptyList();\n83:         Set<String> excludedIds = new HashSet<>(played1);\n84:         excludedIds.addAll(played2);\n85: \n86:         List<Problem> candidates;\n87:         if (!excludedIds.isEmpty()) {\n88:             candidates = problemRepository.findByDifficultyAndIdNotIn(targetDifficulty, new ArrayList<>(excludedIds));\n89:             if (candidates.isEmpty()) {\n90:                 // If specific difficulty unplayed pool is exhausted, try any unplayed difficulty\n91:                 candidates = problemRepository.findByIdNotIn(new ArrayList<>(excludedIds));\n92:             }\n93:         } else {\n94:             candidates = problemRepository.findByDifficultyAndIsActiveTrue(targetDifficulty);\n95:         }\n96: \n97:         if (candidates == null || candidates.isEmpty()) {\n98:             // Fallback to all active problems for this difficulty\n99:             candidates = problemRepository.findByDifficultyAndIsActiveTrue(targetDifficulty);\n100:         }\n101: \n102:         if (candidates.isEmpty()) {\n103:             candidates = problemRepository.findAll();\n104:         }\n105: \n106:         if (candidates.isEmpty()) {\n107:             throw new ResourceNotFoundException(\"No problems available in question bank.\");\n108:         }\n109: \n110:         // Filter by topic if requested and matches exist\n111:         if (preferredTopic != null && !preferredTopic.isBlank()) {\n112:             List<Problem> topicFiltered = candidates.stream()\n113:                     .filter(p -> p.getTopics() != null && p.getTopics().toLowerCase().contains(preferredTopic.toLowerCase()))\n114:                     .toList();\n115:             if (!topicFiltered.isEmpty()) {\n116:                 candidates = topicFiltered;\n117:             }\n118:         }\n119: \n120:         return candidates.get(random.nextInt(candidates.size()));\n121:     }\n122: }\n123: \nThe above content shows the entire, complete file contents of the requested file.\n"}
