 const res = await problemApi.getProblems({\n44:         page,\n45:         size: 20,\n46:         difficulty: difficulty || null,\n47:         topic: topic !== 'All' ? topic : null,\n48:         search: search.trim() || null,\n49:       });\n50: \n51:       if (res.data) {\n52:         setProblems(res.data.content || []);\n53:         setTotalPages(res.data.totalPages || 1);\n54:         setTotalElements(res.data.totalElements || 0);\n55:       }\n56:     } catch (err) {\n57:       console.error(err);\n58:     } finally {\n59:       setLoading(false);\n60:     }\n61:   };\n62: \n63:   const handleSearchSubmit = (e) => {\n64:     e.preventDefault();\n65:     setPage(0);\n66:     loadProblems();\n67:   };\n68: \n69:   return (\n70:     <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6 animate-fade-in\">\n71:       {/* Header */}\n72:       <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n73:         <div>\n74:           <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs font-mono mb-2\">\n75:             <Code2 className=\"w-4 h-4 text-cyan-400\" />\n76:             <span>1,000-Problem Curated Repository</span>\n77:           </div>\n78:           <h1 className=\"text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n79:             Practice Repository\n80:           </h1>\n81:           <p className=\"text-xs sm:text-sm text-slate-400\">\n82:             Hone your competitive programming and interview DSA patterns\n83:           </p>\n84:         </div>\n85: \n86:         {/* Search Bar */}\n87:         <form onSubmit={handleSearchSubmit} className=\"relative w-full md:w-80\">\n88:           <input\n89:             type=\"text\"\n90:             value={search}\n91:             onChange={(e) => setSearch(e.target.value)}\n92:             placeholder=\"Search 1,000 problems by title or ID...\"\n93:             className=\"w-full bg-dark-800 border border-dark-600 rounded-xl px-4 py-2.5 pl-10 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500 transition-colors\"\n94:           />\n95:           <Search className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-3\" />\n96:         </form>\n97:       </div>\n98: \n99:       {/* Difficulty & Topic Filter Chips */}\n100:       <div className=\"space-y-3\">\n101:         {/* Difficulty Selector */}\n102:         <div className=\"flex items-center space-x-2\">\n103:           <button\n104:             onClick={() => { setDifficulty(''); setPage(0); }}\n105:             className={`px-3 py-1.5 rounded-xl text-xs font-semibold font-mono transition-colors ${\n106:               difficulty === '' ? 'bg-indigo-600 text-white' : 'bg-dark-800 text-slate-400 hover:bg-dark-700'\n107:             }`}\n108:           >\n109:             All Difficulties ({totalElements})\n110:           </button>\n111:           <button\n112:             onClick={() => { setDifficulty('EASY'); setPage(0); }}\n113:             className={`px-3 py-1.5 rounded-xl text-xs font-semibold font-mono transition-colors ${\n114:               difficulty === 'EASY' ? 'bg-emerald-600 text-white' : 'bg-dark-800 text-emerald-400 hover:bg-dark-700'\n115:             }`}\n116:           >\n117:             Easy (250)\n118:           </button>\n119:           <button\n120:             onClick={() => { setDifficulty('MEDIUM'); setPage(0); }}\n121:             className={`px-3 py-1.5 rounded-xl text-xs font-semibold font-mono transition-colors ${\n122:               difficulty === 'MEDIUM' ? 'bg-amber-600 text-white' : 'bg-dark-800 text-amber-400 hover:bg-dark-700'\n123:             }`}\n124:           >\n125:             Medium (550)\n126:           </button>\n127:           <button\n128:             onClick={() => { setDifficulty('HARD'); setPage(0); }}\n129:             className={`px-3 py-1.5 rounded-xl text-xs font-semibold font-mono transition-colors ${\n130:               difficulty === 'HARD' ? 'bg-rose-600 text-white' : 'bg-dark-800 text-rose-400 hover:bg-dark-700'\n131:             }`}\n132:           >\n133:             Hard (200)\n134:           </button>\n135:         </div>\n136: \n137:         {/* Topics Horizontal Scroll */}\n138:         <div className=\"flex items-center space-x-2 overflow-x-auto pb-2 scrollbar-none\">\n139:           {TOPIC_LIST.map((t) => (\n140:             <button\n141:               key={t}\n142:               onClick={() => { setTopic(t); setPage(0); }}\n143:               className={`whitespace-nowrap px-3 py-1 rounded-lg text-xs font-medium transition-colors ${\n144:                 topic === t\n145:                   ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40'\n146:                   : 'bg-dark-800/80 text-slate-400 hover:bg-dark-700 border border-dark-700'\n147:               }`}\n148:             >\n149:               {t}\n150:             </button>\n151:           ))}\n152:         </div>\n153:       </div>\n154: \n155:       {/* Problem Table / List */}\n156:       <div className=\"bg-dark-800 border border-dark-600 rounded-3xl overflow-hidden shadow-2xl\">\n157:         {loading ? (\n158:           <div className=\"p-12 text-center text-slate-400 font-mono text-xs\">\n159:             <div className=\"animate-spin rounded-full h-6 w-6 border-b-2 border-cyan-400 mx-auto mb-3\"></div>\n160:             Loading problems...\n161:           </div>\n162:         ) : problems.length === 0 ? (\n163:           <div className=\"p-12 text-center text-slate-500 font-mono text-xs\">\n164:             No problems match your selected criteria.\n165:           </div>\n166:         ) : (\n167:           <div className=\"divide-y divide-dark-700\">\n168:             {problems.map((p) => (\n169:               <div\n170:                 key={p.id}\n171:                 className=\"p-4 sm:px-6 hover:bg-dark-700/50 transition-colors flex flex-col sm:flex-row sm:items-ce