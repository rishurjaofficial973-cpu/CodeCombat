.append(f'<m:e><m:r><m:rPr><m:scr m:val=\"roman\"/><m:sty m:val=\"p\"/></m:rPr><m:t>{cell}</m:t></m:r></m:e>')\n        mr_xml_list.append(f'<m:mr>{\"\".join(e_xml_list)}</m:mr>')\n        \n    m_body = \"\".join(mr_xml_list)\n    \n    xml = f\"\"\"\n    <m:oMath xmlns:m=\"http://schemas.openxmlformats.org/officeDocument/2006/math\">\n      <m:d>\n        <m:dPr>\n          <m:begChr m:val=\"{beg_chr}\"/>\n          <m:endChr m:val=\"{end_chr}\"/>\n          <m:grow m:val=\"on\"/>\n        </m:dPr>\n        <m:e>\n          <m:m>\n            <m:mPr>\n              <m:baseJc m:val=\"center\"/>\n              <m:plcHide m:val=\"on\"/>\n            </m:mPr>\n            {m_body}\n          </m:m>\n        </m:e>\n      </m:d>\n    </m:oMath>\n    \"\"\"\n    return parse_xml(xml)\n\n\ndef append_omml(paragraph, omml_element):\n    \"\"\"Appends an OMML math element to a python-docx paragraph.\"\"\"\n    paragraph._element.append(omml_element)\n","Description":"OMML matrix and determinant generator module.","Overwrite":true,"TargetFile":"C:\\Users\\rajan\\.gemini\\antigravity\\brain\\b78a5d36-6586-4c94-a487-70da0c9f5362\\scratch\\omml_helper.py","toolAction":"Creating OMML helper","toolSummary":"OMML matrix generator"}}]}
