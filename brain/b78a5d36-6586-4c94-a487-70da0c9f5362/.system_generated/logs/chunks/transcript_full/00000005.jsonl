n process. I'm testing a new `add_math_p` function that consistently uses single line spacing for math paragraphs. Additionally, I'm updating `create_base_doc()` to set the \"Normal\" style to use a relative (e.g., 1.15 multiple) or single line spacing, instead of the fixed 14pt. I'm confident this will prevent future matrix display truncations.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Python script to test matrix line height expansion with relative line spacing in MS Word.","UserFacing":false},"CodeContent":"\"\"\"\nTest script to verify all 9 elements of a 3x3 matrix are visible in Word.\n\"\"\"\n\nfrom docx import Document\nfrom docx.shared import Pt, Inches\nfrom docx.enum.text import WD_LINE_SPACING, WD_ALIGN_PARAGRAPH\nfrom docx.oxml import parse_xml\n\ndef make_omml_matrix(rows, bracket='['):\n    beg_chr = '|' if bracket == '|' else '['\n    end_chr = '|' if bracket == '|' else ']'\n    mr_xml_list = []\n    for row in rows:\n        e_xml_list = []\n        for cell in row:\n            e_xml_list.append(f'<m:e><m:r><m:rPr><m:scr m:val=\"roman\"/><m:sty m:val=\"p\"/></m:rPr><m:t>{cell}</m:t></m:r></m:e>')\n        mr_xml_list.append(f'<m:mr>{\"\".join(e_xml_list)}</m:mr>')\n        \n    m_body = \"\".join(mr_xml_list)\n    xml = f\"\"\"\n    <m:oMath xmlns:m=\"http://schemas.openxmlformats.org/officeDocument/2006/math\">\n      <m:d>\n        <m:dPr>\n          <m:begChr m:val=\"{beg_chr}\"/>\n          <m:endChr m:val=\"{end_chr}\"/>\n          <m:grow m:val=\"on\"/>\n        </m:dPr>\n        <m:e>\n          <m:m>\n            <m:mPr>\n              <m:baseJc m:val=\"center\"/>\n              <m:plcHide m:val=\"on\"/>\n            </m:mPr>\n            {m_body}\n          </m:m>\n        </m:e>\n      </m:d>\n    </m:oMath>\n    \"\"\"\n    return parse_xml(xml)\n\ndoc = Document()\n# Set Normal style with SINGLE spacing (not Pt(14) fixed)\nstyle = doc.styles['Normal']\npf = style.paragraph_format\npf.space_before = Pt(0)\npf.space_after = Pt(2)\npf.line_spacing_rule = WD_LINE_SPACING.SINGLE\npf.line_spacing = None\n\np = doc.add_paragraph()\np.paragraph_format.line_spacing_rule = WD_LINE_SPACING.SINGLE\np.paragraph_format.line_spacing = None\np.paragraph_format.space_after = Pt(4)\nr = p.add_run(\"6. The value of x for which the matrix A = \")\np._element.append(make_omml_matrix([['0', '1', '-2'], ['-1', '0', 'x'], ['2', '-3', '0']], bracket='['))\np.add_run(\" is skew-symmetric, is:\\n(a) 3   (b) -3   (c) 2   (d) -2\")\n\np2 = doc.add_paragraph()\np2.paragraph_format.line_spacing_rule = WD_LINE_SPACING.SINGLE\np2.paragraph_format.line_spacing = None\np2.paragraph_format.space_after = Pt(4)\np2.add_run(\"28. Using minors and cofactors, evaluate the determinant:\\n    |A| = \")\np2._element.append(make_omml_matrix([['1', '2', '3'], ['0', '1', '4'], ['5', '6', '0']], bracket='|'))\n\ndoc.save(r\"C:\\Users\\rajan\\.gemini\\antigravity\\scratch\\test_matrix_fixed.docx\")\nprint(\"Saved test_matrix_fixed.docx successfully!\")\n","Description":"Test script for matrix display with single line spacing.","Overwrite":true,"TargetFile":"C:\\Users\\rajan\\.gemini\\antigravity\\brain\\b78a5d36-6586-4c94-a487-70da0c9f5362\\scratch\\test_matrix_fixed.py","toolAction":"Testing matrix height fix","toolSummary":"Test matrix height fix"}}]}
