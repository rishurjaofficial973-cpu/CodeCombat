{"step_index":21,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-24T15:50:30Z","content":"Subagents are creating Set A and Set B content files. While they work, let me prepare the Python script that will convert everything into Word (.docx) files.","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Python script to generate 4 Word documents from the text content files created by subagents.","UserFacing":false},"CodeContent":"\"\"\"\nGenerate Word (.docx) files for Class XII Mathematics Half-Yearly Exam 2026-27.\nReads content from text files and produces properly formatted Word documents.\n\"\"\"\n\nimport os\nimport re\nfrom docx import Document\nfrom docx.shared import Pt, Cm, Inches, RGBColor\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.section import WD_ORIENT\n\nOUTPUT_DIR = r\"C:\\Users\\rajan\\.gemini\\antigravity\\scratch\\math_exam_2026\"\nINPUT_DIR = OUTPUT_DIR\n\n\ndef setup_document():\n    \"\"\"Create a document with proper formatting: A4, narrow margins, Times New Roman 12.\"\"\"\n    doc = Document()\n    \n    # Set page layout\n    section = doc.sections[0]\n    section.page_width = Cm(21.0)   # A4 width\n    section.page_height = Cm(29.7)  # A4 height\n    section.orientation = WD_ORIENT.PORTRAIT\n    # Narrow margins\n    section.top_margin = Cm(1.27)\n    section.bottom_margin = Cm(1.27)\n    section.left_margin = Cm(1.27)\n    section.right_margin = Cm(1.27)\n    \n    # Set default font\n    style = doc.styles['Normal']\n    font = style.font\n    font.name = 'Times New Roman'\n    font.size = Pt(12)\n    font.color.rgb = RGBColor(0, 0, 0)\n    \n    # Set single spacing\n    paragraph_format = style.paragraph_format\n    paragraph_format.space_before = Pt(0)\n    paragraph_format.space_after = Pt(2)\n    paragraph_format.line_spacing = Pt(14)\n    \n    return doc\n\n\ndef add_header(doc, set_name):\n    \"\"\"Add the standard exam header.\"\"\"\n    # School/exam header\n    p = doc.add_paragraph()\n    p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = p.add_run(\"HALF-YEARLY EXAMINATION 2026\\u201327\")\n    run.bold = True\n    run.font.size = Pt(14)\n    run.font.name = 'Times New Roman'\n    \n    p = doc.add_paragraph()\n    p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = p.add_run(f\"CLASS XII \\u2014 MATHEMATICS ({set_name})\")\n    run.bold = True\n    run.font.size = Pt(13)\n    run.font.name = 'Times New Roman'\n    \n    # Time and marks line\n    p = doc.add_paragraph()\n    run1 = p.add_run(\"Time Allowed: 3 Hours\")\n    run1.bold = True\n    run1.font.name = 'Times New Roman'\n    run1.font.size = Pt(12)\n    \n    # Add tab for right alignment\n    p.add_run(\"\\t\\t\\t\\t\\t\\t\\t\\t\")\n    run2 = p.add_run(\"Maximum Marks: 80\")\n    run2.bold = True\n    run2.font.name = 'Times New Roman'\n    run2.font.size = Pt(12)\n\n\ndef add_general_instructions(doc):\n    \"\"\"Add the general instructions section.\"\"\"\n    p = doc.add_paragraph()\n    run = p.add_run(\"General Instructions:\")\n    run.bold = True\n    run.underline = True\n    run.font.name = 'Times New Roman'\n    \n    instructions = [\n        \"This question paper contains five sections \\u2014 A, B, C, D and E. All questions are compulsory.\",\n        \"Section A consists of 20 questions of 1 mark each (Q1\\u2013Q20).\",\n        \"Question numbers 19 and 20 are Assertion\\u2013Reason based questions. Two statements are given, marked Assertion (A) and Reason (R). Select the correct option from the four given below each question.\",\n        \"Section B consists of 5 questions of 2 marks each (Q21\\u2013Q25).\",\n        \"Section C consists of 6 questions of 3 marks each (Q26\\u2013Q31).\",\n        \"Section D consists of 4 questions of 5 marks each (Q32\\u2013Q35).\",\n        \"Section E consists of 3 case-based/source-based questions of 4 marks each (Q36\\u2013Q38), with sub-parts of 2, 1 and 1 marks.\",\n        \"There is no overall choice. All questions are compulsory as set.\",\n        \"Use of calculators is not permitted.\",\n    ]\n    \n    for i, inst in enumerate(instructions, 1):\n        p = doc.add_paragraph()\n        p.paragraph_format.left_indent = Cm(0.5)\n        run = p.add_run(f\"{i}. {inst}\")\n        run.font.name = 'Times New Roman'\n        run.font.size = Pt(12)\n    \n    # Separator line\n    p = doc.add_paragraph()\n    p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = p.add_run(\"\\u2500\" * 80)\n    run.font.size = Pt(8)\n\n\ndef add_section_header(doc, title):\n    \"\"\"Add a bold, centered section header.\"\"\"\n    p = doc.add_paragraph()\n    p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = p.add_run(title)\n    run.bold = True\n    run.font.name = 'Times New Roman'\n    run.font.size = Pt(13)\n\n\ndef add_section_subtitle(doc, text):\n    \"\"\"Add section subtitle (mark description).\"\"\"\n    p = doc.add_paragraph()\n    p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = p.add_run(text)\n    run.italic = True\n    run.font.name = 'Times New Roman'\n    run.font.size = Pt(11)\n\n\ndef txt_to_docx(input_path, output_path, is_marking_scheme=False):\n    \"\"\"Convert a text file to a formatted Word document.\"\"\"\n    doc = setup_document()\n    \n    with open(input_path, 'r', encoding='utf-8') as f:\n        lines = f.readlines()\n    \n    for line in lines:\n        line = line.rstrip('\\n')\n        \n        # Detect section headers\n        if line.strip().startswith(\"HALF-YEARLY\") or line.strip().startswith(\"CLASS XII\"):\n            p = doc.add_paragraph()\n            p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n            run = p.add_run(line.strip())\n            run.bold = True\n            run.font.name = 'Times New Roman'\n            run.font.size = Pt(14) if \"HALF-YEARLY\" in line else Pt(13)\n            continue\n        \n        if \"SECTION A\" in line or \"SECTION B\" in line or \"SECTION C\" in line or \"SECTION D\" in line or \"SECTION E\" in line:\n            if line.strip().startswith(\"SECTION\"):\n                p = doc.add_paragraph()\n                p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                run = p.add_run(line.strip())\n                run.bold = True\n                run.font.name = 'Times New Roman'\n                run.font.size = Pt(13)\n                continue\n        \n        if line.strip().startswith(\"MARKING SCHEME\"):\n            p = doc.add_paragraph()\n            p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n            run = p.add_run(line.strip())\n            run.bold = True\n            run.font.name = 'Times New Roman'\n            run.font.size = Pt(14)\n            continue\n        \n        # Regular paragraph\n        p = doc.add_paragraph()\n        run = p.add_run(line)\n        run.font.name = 'Times New Roman'\n        run.font.size = Pt(12)\n    \n    doc.save(output_path)\n    print(f\"  Created: {output_path}\")\n\n\ndef convert_all():\n    \"\"\"Convert all text files to Word documents.\"\"\"\n    files = [\n        (\"Set_A_Question_Paper.txt\", \"Set_A_Question_Paper.docx\"),\n        (\"Set_A_Marking_Scheme.txt\", \"Set_A_Marking_Scheme.docx\"),\n        (\"Set_B_Question_Paper.txt\", \"Set_B_Question_Paper.docx\"),\n        (\"Set_B_Marking_Scheme.txt\", \"Set_B_Marking_Scheme.docx\"),\n    ]\n    \n    print(\"Converting text files to Word documents...\")\n    print(f\"Input/Output directory: {OUTPUT_DIR}\\n\")\n    \n    success_count = 0\n    for txt_file, docx_file in files:\n        input_path = os.path.join(INPUT_DIR, txt_file)\n        output_path = os.path.join(OUTPUT_DIR, docx_file)\n        \n        if not os.path.exists(input_path):\n            print(f\"  SKIPPED (not found): {txt_file}\")\n            continue\n        \n        try:\n            is_ms = \"Marking_Scheme\" in txt_file\n            txt_to_docx(input_path, output_path, is_marking_scheme=is_ms)\n            success_count += 1\n        except Exception as e:\n            print(f\"  ERROR converting {txt_file}: {e}\")\n    \n    print(f\"\\nDone! {success_count}/{len(files)} files converted successfully.\")\n    print(f\"Output location: {OUTPUT_DIR}\")\n\n\nif __name__ == \"__main__\":\n    convert_all()\n","Description":"Script to convert the text exam files into properly formatted Word (.docx) documents with Times New Roman 12pt, A4 portrait, narrow margins.","Overwrite":false,"TargetFile":"C:\\Users\\rajan\\.gemini\\antigravity\\scratch\\math_exam_2026\\generate_word_files.py","toolAction":"Creating Word generator","toolSummary":"Word conversion script"}}]}
{"step_index":23,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-24T15:51:08Z","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Python script to convert text exam files into formatted Word documents with proper CBSE formatting.","UserFacing":false},"CodeContent":"\"\"\"\nGenerate Word (.docx) files for Class XII Mathematics Half-Yearly Exam 2026-27.\nReads content from text files and produces properly formatted Word documents.\n\"\"\"\n\nimport os\nfrom docx import Document\nfrom docx.shared import Pt, Cm, RGBColor\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.section import WD_ORIENT\n\nDIR = r\"C:\\Users\\rajan\\.gemini\\antigravity\\scratch\\math_exam_2026\"\n\n\ndef setup_document():\n    \"\"\"Create a document with proper formatting: A4, narrow margins, Times New Roman 12.\"\"\"\n    doc = Document()\n    section = doc.sections[0]\n    section.page_width = Cm(21.0)\n    section.page_height = Cm(29.7)\n    section.orientation = WD_ORIENT.PORTRAIT\n    section.top_margin = Cm(1.27)\n    section.bottom_margin = Cm(1.27)\n    section.left_margin = Cm(1.27)\n    section.right_margin = Cm(1.27)\n\n    style = doc.styles['Normal']\n    font = style.font\n    font.name = 'Times New Roman'\n    font.size = Pt(12)\n    font.color.rgb = RGBColor(0, 0, 0)\n    pf = style.paragraph_format\n    pf.space_before = Pt(0)\n    pf.space_after = Pt(2)\n    pf.line_spacing = Pt(14)\n    return doc\n\n\ndef txt_to_docx(input_path, output_path):\n    \"\"\"Convert a text file to a formatted Word document.\"\"\"\n    doc = setup_document()\n\n    with open(input_path, 'r', encoding='utf-8') as f:\n        lines = f.readlines()\n\n    for line in lines:\n        line = line.rstrip('\\n')\n\n        is_center = False\n        is_bold = False\n        font_size = Pt(12)\n\n        stripped = line.strip()\n\n        if stripped.startswith(\"HALF-YEARLY\") or stripped.startswith(\"CLASS XII\"):\n            is_center = True\n            is_bold = True\n            font_size = Pt(14) if \"HALF-YEARLY\" in stripped else Pt(13)\n        elif stripped.startswith(\"SECTION \"):\n            is_center = True\n            is_bold = True\n            font_size = Pt(13)\n        elif stripped.startswith(\"MARKING SCHEME\"):\n            is_center = True\n            is_bold = True\n            font_size = Pt(14)\n        elif stripped.startswith(\"Time Allowed\") or stripped.startswith(\"Maximum Marks\"):\n            is_bold = True\n        elif stripped.startswith(\"General Instructions\"):\n            is_bold = True\n        elif stripped.startswith(\"-- End of\") or stripped.startswith(\"\\u2014 End of\"):\n            is_center = True\n            is_bold = True\n\n        p = doc.add_paragraph()\n        if is_center:\n            p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n        run = p.add_run(line)\n        run.font.name = 'Times New Roman'\n        run.font.size = font_size\n        run.bold = is_bold\n\n    doc.save(output_path)\n    print(f\"  Created: {output_path}\")\n\n\ndef main():\n    files = [\n        (\"Set_A_Question_Paper.txt\", \"Set_A_Question_Paper.docx\"),\n        (\"Set_A_Marking_Scheme.txt\", \"Set_A_Marking_Scheme.docx\"),\n        (\"Set_B_Question_Paper.txt\", \"Set_B_Question_Paper.docx\"),\n        (\"Set_B_Marking_Scheme.txt\", \"Set_B_Marking_Scheme.docx\"),\n    ]\n\n    print(\"Converting text files to Word documents...\")\n    print(f\"Directory: {DIR}\\\\n\")\n\n    ok = 0\n    for txt, docx in files:\n        inp = os.path.join(DIR, txt)\n        out = os.path.join(DIR, docx)\n        if not os.path.exists(inp):\n            print(f\"  SKIPPED (not found): {txt}\")\n            continue\n        try:\n            txt_to_docx(inp, out)\n            ok += 1\n        except Exception as e:\n            print(f\"  ERROR {txt}: {e}\")\n\n    print(f\"\\\\nDone! {ok}/{len(files)} files converted.\")\n    print(f\"Output: {DIR}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","Description":"Script to convert text exam files into Word documents with CBSE formatting.","Overwrite":false,"TargetFile":"C:\\Users\\rajan\\.gemini\\antigravity\\brain\\b78a5d36-6586-4c94-a487-70da0c9f5362\\scratch\\generate_word_files.py","toolAction":"Creating Word generator","toolSummary":"Word conversion script"}}]}
