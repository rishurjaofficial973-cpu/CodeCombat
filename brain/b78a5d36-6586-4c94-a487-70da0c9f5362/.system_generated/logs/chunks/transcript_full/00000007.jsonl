p.diff(V, x, 2)\nprint(\"Set A Q34 d2V at x=2:\", d2V.subs(x, 2))\nprint(\"Set A Q34 Max volume at x=2:\", V.subs(x, 2))\n# root = 2, d2V = -84 < 0, max vol = 200 cm^3 -> Verified!\n\n# Q35 (5m): (x^2+1)/(x^2-5x+6) = 1 + (5x-5)/((x-2)(x-3)) = 1 - 5/(x-2) + 10/(x-3)\n# Integral = x - 5 ln|x-2| + 10 ln|x-3| + C -> Verified!\n\n# Q36 Case Study 1 (4m):\n# (i) equivalence [2m]\n# (ii) [2] = {2, 4} [1m]\n# (iii) |1-5|=4 even => Yes [1m]\n\n# Q37 Case Study 2 (4m):\n# (i) AX = B: [[3,2,4],[4,1,3]][x,y,z]^T = [4300, 3800]^T [2m]\n# (ii) 3(500) + 2y + 4(600) = 4300 => 1500 + 2y + 2400 = 4300 => 2y = 400 => y = 200 [1m]\n# (iii) Value question [1m]\n\n# Q38 Case Study 3 (4m):\n# (i) MR(x) = 6x + 36, MR(10) = 96 [2m]\n# (ii) MC(x) = 0.015x^2 - 0.04x + 30, MC(2) = 0.015(4) - 0.08 + 30 = 29.98 [1m]\n# (iii) P(x) = R(x) - C(x) [1m]\n\nprint(\"\\n=== AUDITING SET B ===\")\n# Q1: equivalence on {1,2,3} -> (c)\n# Q2: 3! = 6 -> (b)\n# Q3: cos^-1(-1/sqrt(2)) = 3pi/4 -> (b)\n# Q4: domain sin^-1(3x-1): -1<=3x-1<=1 => [0, 2/3] -> (a)\n# Q5: tan^-1(-1) = -pi/4 -> (b)\n# Q6: a = -2, b = 3 => a+b = 1 -> (a)\n# Q7: a_ij = 0 for i!=j -> (b)\n# Q8: (A+B)^T = A^T + B^T -> (a)\n# Q9: |3A| = 27(-2) = -54 -> (b)\n# Q10: Area of (1,0),(6,0),(4,3) = 15/2 -> (b)\n# Q11: d/dx sin(3x) = 3cos(3x) -> (b)\n# Q12: dV/dr = 4 pi r^2 -> (a)\n# Q13: integral cos x dx = sin x + C -> (a)\n# Q14: integral 1/sqrt(a^2-x^2) dx = sin^-1(x/a) + C -> (a)\n# Q15: integral e^-x dx = -e^-x + C -> (b)\n# Q16: integral csc^2 x dx = -cot x + C -> (b)\n# Q17: integral sec x tan x dx = sec x + C -> (a)\n# Q18: integral x^4 dx = x^5/5 + C -> (b)\n# Q19: AR [x] -> (a)\n# Q20: AR ln x -> (a)\n\n# Q21 (2m): Equivalence [2m]\n# Q22 (2m): cos^-1(-1/2) + 2sin^-1(1/2) = 2pi/3 + 2(pi/6) = pi [2m]\n# Q23 (2m): 4k = 3 => k = 3/4 [2m]\n# Q24 (2m): dy/dx = -2x sin(x^2) [2m]\n# Q25 (2m): integral e^(sin x) cos x dx = e^(sin x) + C [2m]\n\n# Q26 (3m): (i) 3pi/4 (ii) -pi/3 (iii) -pi/6\n# Q27 (3m):\nA_b = np.array([[3, 1], [-1, 2]])\nB_b = np